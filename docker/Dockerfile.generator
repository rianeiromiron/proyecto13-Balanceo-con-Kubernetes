FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd/generator ./cmd/generator
COPY internal/db ./internal/db
RUN CGO_ENABLED=0 go build -o /out/generator ./cmd/generator

FROM alpine:3.20
COPY --from=build /out/generator /usr/local/bin/generator
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/generator"]
