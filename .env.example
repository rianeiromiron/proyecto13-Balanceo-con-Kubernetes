# Configuración para el monitor gráfico (cmd/gui), que corre nativo en el
# host y se conecta a Postgres publicado por Kubernetes vía NodePort.
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=loadbalancer_db
DB_SSLMODE=disable

# API de control del generador (Pod en Kubernetes, NodePort publicado)
GENERATOR_CONTROL_URL=http://localhost:9091
